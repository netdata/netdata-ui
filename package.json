{
  "name": "@netdata/netdata-ui",
  "version": "5.6.1",
  "description": "netdata UI kit",
  "main": "dist/index.js",
  "module": "dist/es6/index.js",
  "jsnext:main": "dist/es6/index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:netdata/netdata-ui.git"
  },
  "author": "Netdata",
  "license": "GPL-3.0",
  "private": false,
  "files": [
    "/dist"
  ],
  "scripts": {
    "testOut": "yarn test --env=jsdom --json --outputFile=.jest-test-results.json",
    "build:cjs": "babel src --out-dir dist --copy-files --ignore **/*.stories.js",
    "build:es6": "BABEL_ENV=es6 babel src --out-dir dist/es6 --copy-files --ignore **/*.stories.js",
    "build:umd": "NODE_ENV=production webpack",
    "build": "yarn build:umd && yarn build:cjs && yarn build:es6",
    "clean": "rimraf lib dist es coverage",
    "test": "jest --config ./jest/config.js",
    "lint": "eslint src",
    "cp-cloud": "cp -R ./dist ${CLOUD_DIR:-../cloud-frontend}/node_modules/@netdata/netdata-ui/",
    "to-cloud": "yarn build:cjs && yarn build:es6 && yarn cp-cloud",
    "cp-charts": "cp -R ./dist ../charts/node_modules/@netdata/netdata-ui/",
    "to-charts": "yarn build && yarn cp-charts",
    "prepublishOnly": "yarn clean && yarn build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "visual:build": "storybook build -o storybook-static --quiet",
    "test:visual": "yarn visual:build && docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test -c visual/playwright.config.js",
    "test:visual:update": "yarn visual:build && docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test -c visual/playwright.config.js --update-snapshots"
  },
  "keywords": [
    "netdata",
    "frontend",
    "ui-kit"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@elastic/react-search-ui": "^1.24.2",
    "@elastic/search-ui-site-search-connector": "^1.24.2",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@prismicio/client": "^7.23.0",
    "@styled-system/css": "^5.1.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "axios": "^1.21.1",
    "polished": "^4.3.1",
    "react-portal": "^4.3.0",
    "react-select": "^5.10.2",
    "styled-system": "^5.1.5",
    "throttle-debounce": "^5.0.2",
    "use-context-selector": "^2.0.0"
  },
  "peerDependencies": {
    "lodash": "*",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "styled-components": ">=5.3.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-umd": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-links": "10.6.6",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-styled-components": "^2.4.0",
    "clean-webpack-plugin": "^4.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "^17.14.0",
    "html-loader": "^5.1.0",
    "identity-obj-proxy": "^3.0.0",
    "install-peers-cli": "^2.2.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "^7.4.1",
    "lodash": "^4.18.1",
    "markdown-loader": "^8.0.0",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "sass-loader": "^17.1.0",
    "storybook": "10.6.6",
    "styled-components": "^6.3.10",
    "svg-sprite-loader": "^6.0.11",
    "svgo-loader": "^5.0.0",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
}
