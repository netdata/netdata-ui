  box-sizing: border-box;
  text-decoration: none;
}

.c0.c0>span {
  text-transform: lowercase;
  margin-left: 0px;
}

.c0.c0>span::first-letter {
  text-transform: uppercase;
}

.c0.c0:hover {
  border-color: rgba(255,255,255,0.0);
  background-color: rgba(255,255,255,0.0);
  color: #006729;
  text-decoration: none;
