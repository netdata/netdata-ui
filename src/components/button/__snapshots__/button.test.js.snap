.c0.c0[aria-disabled="true"] {
  opacity: 0.4;
  cursor: not-allowed;
}

.c0.c0[aria-disabled="true"]:hover,
.c0.c0[aria-disabled="true"]:active {
  border-color: rgba(255,255,255,0.0);
  background-color: rgba(255,255,255,0.0);
  color: #007830;
  text-decoration: none;
}

.c0.c0[aria-disabled="true"]:hover .button-icon,
.c0.c0[aria-disabled="true"]:active .button-icon {
  fill: #007830;
}

.c0.c0:focus {
  outline: none;
}

.c0.c0:focus-visible {
  outline: 2px solid #007830;
  outline-offset: 2px;
}

.c0.c0 .button-icon {
  height: 14px;
  width: 14px;
  fill: #007830;
}

.c0.c0 .ntd-spinner {
  fill: none;
  stroke-width: 17px;
  stroke-dasharray: 100;
  stroke-dashoffset: 100;
